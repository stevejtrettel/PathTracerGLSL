            "u_previous": "accumulation_previous",
          },
        },
        "output": "accumulation_current",
        "shader": "direct-minimal-main",
      },
      {
        "execution": {
          "type": "once",
        },
        "id": "display-pass",
        "inputs": {
          "textures": {
            "u_radiance": "accumulation_current",
          },
        },
        "output": "screen",
        "shader": "direct-minimal-display",
      },
    ],
    "postFrame": {
