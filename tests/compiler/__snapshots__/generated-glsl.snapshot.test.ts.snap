        "type": "texture",
      },
    ],
    "passes": [
      {
        "execution": {
          "type": "once",
        },
        "id": "pathtracer-pass",
        "inputs": {
          "textures": {
            "u_previous": "accumulation_previous",
          },
        },
        "output": "accumulation_current",
        "shader": "furnace-scatter-furnace-scatter-main",
      },
      {
        "execution": {
          "type": "once",
        },
