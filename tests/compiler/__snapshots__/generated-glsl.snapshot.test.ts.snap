exports[`generated GLSL snapshot (§2.10 refactor safety net) > minimal + direct 1`] = `
{
  "exportTargets": {
    "hdr": {
      "bufferId": "accumulation_previous",
      "format": "float",
    },
  },
  "id": "direct-minimal",
  "parameters": {
    "camera.position": {
      "default": [
        0,
        0,
        8,
      ],
      "group": "Camera",
      "name": "Position",
      "triggersReset": true,
      "type": "vec3",
    },
    "camera.target": {
      "default": [
        0,
        0,
        0,
      ],
      "group": "Camera",
      "name": "Target",
      "triggersReset": true,
      "type": "vec3",
    },
    "environment.color": {
