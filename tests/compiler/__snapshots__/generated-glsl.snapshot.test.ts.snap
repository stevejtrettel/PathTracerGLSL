  "id": "pt-cornell-area",
  "parameters": {
    "camera.fov": {
      "default": 0.8,
      "group": "Camera",
      "name": "FOV",
      "range": [
        0.3,
        1.5,
      ],
      "triggersReset": true,
      "type": "float",
    },
    "camera.position": {
      "default": [
        0,
        0,
        8,
      ],
      "group": "Camera",
      "name": "Position",
      "triggersReset": true,
      "type": "vec3",
    },
    "camera.target": {
      "default": [
        0,
        0,
        0,
      ],
      "group": "Camera",
      "name": "Target",
      "triggersReset": true,
      "type": "vec3",
    },
    "clay.albedo": {
      "default": [
        0.8,
        0.4,
        0.2,
      ],
      "group": "clay",
      "name": "Albedo",
      "triggersReset": true,
      "type": "color",
    },
  },
  "pipeline": {
    "framebuffers": [
      {
        "format": "rgba32f",
        "id": "accumulation",
        "type": "double_buffer",
      },
      {
        "format": undefined,
        "id": "screen",
        "type": "screen",
      },
      {
        "format": "rgba8",
        "id": "ldr",
        "type": "texture",
      },
    ],
    "passes": [
      {
        "execution": {
          "type": "once",
        },
        "id": "pathtracer-pass",
        "inputs": {
