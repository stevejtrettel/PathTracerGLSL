      "uniform": "u_sampleCount",
    },
    {
      "parameters": [
        "engine.pixelOffset",
      ],
      "type": "vec2",
      "uniform": "u_pixelOffset",
    },
  ],
}
`;

exports[`generated GLSL snapshot (§2.10 refactor safety net) > furnace-sky + pt-nee 1`] = `
{
  "exportTargets": {
