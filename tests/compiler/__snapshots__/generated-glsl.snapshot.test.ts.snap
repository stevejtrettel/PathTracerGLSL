        "camera.target",
      ],
      "type": "vec3",
      "uniform": "u_cameraUp",
    },
    {
      "parameters": [
        "engine.imageSize",
      ],
      "type": "vec2",
      "uniform": "u_imageSize",
    },
    {
      "parameters": [
        "engine.imageSize",
      ],
      "type": "float",
