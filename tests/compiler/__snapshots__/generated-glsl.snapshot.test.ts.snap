      "uniform": "u_cameraUp",
    },
    {
      "parameters": [
        "engine.imageSize",
      ],
      "type": "vec2",
      "uniform": "u_imageSize",
    },
    {
      "parameters": [
        "engine.imageSize",
      ],
      "type": "float",
      "uniform": "u_aspect",
    },
    {
      "parameters": [
        "camera.fov",
      ],
