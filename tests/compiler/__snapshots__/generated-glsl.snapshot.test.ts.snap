  },
  "pipeline": {
    "framebuffers": [
      {
        "format": "rgba32f",
        "id": "accumulation",
        "type": "double_buffer",
      },
      {
        "format": undefined,
        "id": "screen",
        "type": "screen",
      },
    ],
    "passes": [
      {
        "execution": {
          "type": "once",
        },
        "id": "pathtracer-pass",
        "inputs": {
          "textures": {
            "u_previous": "accumulation_previous",
          },
        },
        "output": "accumulation_current",
        "shader": "pt-fog-area-main",
      },
      {
        "execution": {
          "type": "once",
        },
        "id": "display-pass",
        "inputs": {
          "textures": {
            "u_radiance": "accumulation_current",
          },
        },
        "output": "screen",
        "shader": "pt-fog-area-display",
