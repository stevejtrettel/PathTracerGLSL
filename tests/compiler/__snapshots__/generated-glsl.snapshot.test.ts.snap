  "id": "pathtracer-fogcube",
  "parameters": {
    "camera.position": {
      "default": [
        0,
        0,
        8,
      ],
      "group": "Camera",
      "name": "Position",
      "triggersReset": true,
      "type": "vec3",
    },
    "camera.target": {
      "default": [
        0,
        0,
        0,
      ],
      "group": "Camera",
      "name": "Target",
      "triggersReset": true,
      "type": "vec3",
    },
  },
  "pipeline": {
    "framebuffers": [
      {
        "format": "rgba32f",
        "id": "accumulation",
        "type": "double_buffer",
      },
      {
        "format": undefined,
        "id": "screen",
        "type": "screen",
      },
    ],
    "passes": [
      {
        "execution": {
          "type": "once",
        },
        "id": "pathtracer-pass",
        "inputs": {
          "textures": {
            "u_previous": "accumulation_previous",
          },
        },
        "output": "accumulation_current",
        "shader": "pathtracer-fogcube-main",
      },
      {
        "execution": {
          "type": "once",
        },
        "id": "display-pass",
        "inputs": {
          "textures": {
            "u_radiance": "accumulation_current",
          },
        },
        "output": "screen",
        "shader": "pathtracer-fogcube-display",
      },
    ],
    "postFrame": {
      "swaps": [
        {
          "buffers": [
            "accumulation",
          ],
          "type": "swap",
        },
      ],
    },
  },
  "shaders": {
    "pathtracer-fogcube-display": {
      "fragment": "#version 300 es
precision highp float;
precision highp int;

out vec4 fragColor;
// Reinhard Tonemapping Display Pass
// Full fragment shader for display pass
// Reads HDR radiance, applies Reinhard + sRGB, outputs LDR

uniform vec2 u_resolution;
uniform sampler2D u_radiance;

vec3 safe_color(vec3 c) {
    c = max(c, vec3(0.0));
    bvec3 ok = lessThanEqual(abs(c), vec3(1e19));
    if (!(ok.x && ok.y && ok.z)) return vec3(0.0);
    return c;
}

vec3 linear_to_srgb(vec3 c) {
    vec3 lo = 12.92 * c;
    vec3 hi = 1.055 * pow(max(c, 0.0), vec3(1.0 / 2.4)) - 0.055;
    bvec3 cutoff = lessThanEqual(c, vec3(0.0031308));
    return mix(hi, lo, vec3(cutoff));
}

vec3 tonemap_reinhard(vec3 x) {
    return x / (1.0 + x);
}

void main() {
    vec2 uv = gl_FragCoord.xy / u_resolution;
    vec3 radiance = texture(u_radiance, uv).rgb;
    vec3 color = safe_color(radiance);
    color = tonemap_reinhard(color);
    color = clamp(linear_to_srgb(color), 0.0, 1.0);
    fragColor = vec4(color, 1.0);
}
