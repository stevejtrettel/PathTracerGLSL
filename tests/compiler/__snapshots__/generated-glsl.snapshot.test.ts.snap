    "environment.intensity": {
      "default": 1,
      "group": "Environment",
      "name": "Sky intensity",
      "range": [
        0,
        5,
      ],
      "triggersReset": true,
      "type": "float",
    },
  },
  "pipeline": {
    "framebuffers": [
      {
        "format": "rgba32f",
        "id": "accumulation",
        "type": "double_buffer",
      },
      {
        "format": undefined,
        "id": "screen",
        "type": "screen",
      },
    ],
    "passes": [
      {
        "execution": {
          "type": "once",
        },
        "id": "pathtracer-pass",
        "inputs": {
          "textures": {
            "u_previous": "accumulation_previous",
          },
        },
        "output": "accumulation_current",
        "shader": "direct-minimal-main",
      },
      {
        "execution": {
          "type": "once",
        },
        "id": "display-pass",
        "inputs": {
          "textures": {
            "u_radiance": "accumulation_current",
          },
        },
        "output": "screen",
        "shader": "direct-minimal-display",
