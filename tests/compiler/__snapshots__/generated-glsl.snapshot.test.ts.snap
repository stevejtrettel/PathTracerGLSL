        "inputs": {
          "textures": {
            "u_blueNoise": "extern:blue_noise",
            "u_radiance": "accumulation_current",
          },
        },
        "output": "screen",
        "shader": "pt-nee-orb-display",
      },
    ],
    "postFrame": {
