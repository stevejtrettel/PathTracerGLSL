      },
      {
        "format": undefined,
        "id": "screen",
        "type": "screen",
      },
      {
        "format": "rgba8",
        "id": "ldr",
        "type": "texture",
      },
    ],
    "passes": [
      {
        "execution": {
          "type": "once",
        },
        "id": "pathtracer-pass",
        "inputs": {
