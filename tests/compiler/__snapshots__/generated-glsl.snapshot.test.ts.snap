exports[`generated GLSL snapshot (§2.10 refactor safety net) > minimal + direct 1`] = `
{
  "exportTargets": {
    "ldr": {
      "bufferId": "ldr",
      "format": "byte",
    },
    "radiance": {
      "bufferId": "accumulation_previous",
      "format": "float",
      "picture": {
        "formats": [
          "hdr",
          "png",
        ],
        "view": "tonemap",
      },
    },
  },
  "id": "direct-minimal",
  "parameters": {
    "camera.fov": {
      "default": 0.8,
      "group": "Camera",
      "name": "FOV",
      "triggersReset": true,
