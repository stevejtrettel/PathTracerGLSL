            hit.eps = spawn_eps_fp(hit.p);
            hit.frame = ambient_frame(hit.p, quad_normal(hit.p, shape));
            hit.ng = hit.frame.n;   // a primitive's normal is its true surface normal
            hit.region_owner = 3;
