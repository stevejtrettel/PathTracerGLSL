      },
      {
        "execution": {
          "type": "once",
        },
        "id": "display-pass",
        "inputs": {
          "textures": {
            "u_blueNoise": "extern:blue_noise",
            "u_radiance": "accumulation_current",
          },
        },
        "output": "screen",
        "shader": "pathtracer-mixed-display",
      },
    ],
    "postFrame": {
