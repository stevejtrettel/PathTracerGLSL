exports[`generated GLSL snapshot (§2.10 refactor safety net) > mist demo 1`] = `
{
  "exportTargets": {
    "ldr": {
      "bufferId": "ldr",
      "format": "byte",
    },
    "radiance": {
      "bufferId": "accumulation_previous",
      "format": "float",
      "picture": {
