      "range": [
        -3.141592653589793,
        3.141592653589793,
      ],
      "triggersReset": true,
      "type": "float",
    },
  },
  "pipeline": {
    "framebuffers": [
      {
        "format": "rgba32f",
        "id": "accumulation",
        "type": "double_buffer",
      },
      {
        "format": undefined,
        "id": "screen",
        "type": "screen",
      },
      {
        "format": "rgba8",
        "id": "ldr",
        "type": "texture",
      },
    ],
    "passes": [
      {
        "execution": {
          "type": "once",
        },
        "id": "pathtracer-pass",
        "inputs": {
          "textures": {
            "u_envCdfCond": "extern:env_cdf_cond",
            "u_envCdfMarg": "extern:env_cdf_marg",
            "u_envMap": "extern:env_map",
            "u_previous": "accumulation_previous",
          },
        },
        "output": "accumulation_current",
        "shader": "pt-mis-sky-lamp-main",
      },
      {
        "execution": {
          "type": "once",
        },
        "id": "display-pass",
        "inputs": {
          "textures": {
            "u_blueNoise": "extern:blue_noise",
            "u_radiance": "accumulation_current",
          },
        },
        "output": "screen",
        "shader": "pt-mis-sky-lamp-display",
      },
    ],
    "postFrame": {
