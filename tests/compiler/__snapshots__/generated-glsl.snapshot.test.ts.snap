        "engine.sampleCount",
      ],
      "type": "int",
      "uniform": "u_sampleCount",
    },
    {
      "parameters": [
        "engine.pixelOffset",
      ],
      "type": "vec2",
      "uniform": "u_pixelOffset",
    },
    {
      "parameters": [
        "engine.resolution",
      ],
      "type": "vec2",
      "uniform": "u_resolution",
    },
  ],
}
`;

exports[`generated GLSL snapshot (§2.10 refactor safety net) > sky + pt-mis-oct 1`] = `
{
  "exportTargets": {
