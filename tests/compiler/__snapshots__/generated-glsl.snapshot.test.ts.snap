    "passes": [
      {
        "execution": {
          "type": "once",
        },
        "id": "pathtracer-pass",
        "inputs": {
          "textures": {
            "u_envCdfCond": "extern:env_cdf_cond_oct",
            "u_envCdfMarg": "extern:env_cdf_marg_oct",
            "u_envMap": "extern:env_map",
