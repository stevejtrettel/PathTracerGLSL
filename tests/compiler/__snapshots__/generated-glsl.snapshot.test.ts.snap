      ],
      "type": "int",
      "uniform": "u_sampleCount",
    },
    {
      "parameters": [
        "engine.pixelOffset",
      ],
      "type": "vec2",
      "uniform": "u_pixelOffset",
    },
    {
      "parameters": [
        "engine.resolution",
      ],
      "type": "vec2",
      "uniform": "u_resolution",
    },
